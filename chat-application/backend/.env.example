# =============================================================================
# Messenger – Backend Environment Variables
# Copy this file to .env and fill in your real values.
# Lines starting with # are comments. Optional vars are marked [optional].
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000

# "development" enables verbose logging; "production" serves the built
# frontend from ../frontend/dist and disables stack-trace leakage.
NODE_ENV=development

# Logging level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent'
LOG_LEVEL=info

# URL of the frontend (used in CORS, Socket.io origin, and reset-password emails)
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/chat

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# ---------------------------------------------------------------------------
# Redis [optional]
# When set, enables:
#   1. The Socket.io Redis adapter for horizontal scaling and cross-instance presence.
#   2. BullMQ background job queue and worker for asynchronous email delivery.
# When unset, the server runs in single-instance mode with in-process email fallback.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Email (Resend — https://resend.com)
# Used for: welcome emails, password-reset emails
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Messenger

# ---------------------------------------------------------------------------
# File uploads (Cloudinary — https://cloudinary.com/console)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# Rate limiting / bot protection (Arcjet — https://arcjet.com)
# ARCJET_ENV=development disables enforcement so local dev is never blocked.
# ---------------------------------------------------------------------------
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARCJET_ENV=development
